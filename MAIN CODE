<!DOCTYPE html>
<html>
<head>
  <title>Web AR Homework</title>
  <script src="https://aframe.io/releases/1.2.0/aframe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/AR-js-org/AR.js/aframe/build/aframe-ar.js"></script>
</head>
<body>
  <a-scene embedded arjs="sourceType: webcam;">
    <a-marker preset="hiro">

      <!--1. Box  -->
      <a-box
        position="0 0.5 0"
        rotation="0 45 0"
        color="#4CC3D9"
        scale="0.5 0.5 0.5">
      </a-box>

      <!-- 2. Sphere -->
      <a-sphere
        position="-0.8 0.4 0"
        radius="0.3"
        color="#EF2D5E">
      </a-sphere>

      <!-- 3. Cylinder-->
      <a-cylinder
        position="0.8 0.4 0"
        radius="0.2"
        height="0.8"
        color="#FFC65D">
      </a-cylinder>

      <!-- 4. Cone -->
      <a-cone
        position="0 0.5 -0.8"
        radius-bottom="0.3"
        height="0.7"
        color="#7BC8A4">
      </a-cone>

    </a-marker>
    <a-entity camera></a-entity>
  </a-scene>
</body>
</html>
